{
  "name": "ycandela-42",
  "version": "1.0.0",
  "description": "ycandela-42 (YC42) - token ERC-20 sur Ethereum pour le projet Tokenizer de 42",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "hardhat build",
    "test": "hardhat test",
