# Modèle du fichier .env. Pour l'utiliser :
#   cp .env.example .env
# puis remplis .env (et pas ce fichier-ci, qui est commit).
# .env contient des secrets : il est dans le .gitignore et ne doit JAMAIS être commit.

# Adresse d'un nœud Sepolia, par lequel Hardhat envoie les transactions.
# Celle-ci est publique et gratuite ; Alchemy ou Infura en fournissent aussi.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Clé privée du wallet de TEST qui déploie le contrat (jamais celle d'un wallet perso).
SEPOLIA_PRIVATE_KEY=

# Clé API Etherscan (gratuite, depuis ton compte etherscan.io), pour publier
# le code source vérifié du contrat.
ETHERSCAN_API_KEY=
